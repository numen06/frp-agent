{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "后端: FastAPI (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend",
                "APP_DEBUG": "true"
            },
            "jinja": true
        },
        {
            "name": "前端: 仅启动Vite(不打开浏览器)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev -- --host 0.0.0.0 --port 5173 --strictPort",
            "cwd": "${workspaceFolder}/frontend",
            "env": {
                "NODE_OPTIONS": "",
                "VSCODE_INSPECTOR_OPTIONS": ""
            }
        }
    ],
    "compounds": [
        {
            "name": "启动: 前后端 (2个进程)",
            "configurations": [
                "后端: FastAPI (Uvicorn)",
                "前端: 仅启动Vite(不打开浏览器)"
            ]
        }
    ]
}

